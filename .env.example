# Nothing is required: the digest uses public RSS feeds and a free local
# summarizer. Everything below is optional.

# Post the top stories to a Discord channel
DISCORD_WEBHOOK_URL=

# Enable AI neutral headlines, summaries and "how each side framed it"
# for the top stories (see llm: in config.yaml)
ANTHROPIC_API_KEY=

# Public URL of your GitHub Pages site (linked from the Discord post)
SITE_URL=
